--  Standalone build helper: copies the i18n dependency's generated locale data
--  into the files crate's share/i18n tree. Deliberately its own project with no
--  dependencies, so it builds with plain gprbuild (no Alire solve) and lands in
--  tools/i18n_bundle/bin -- NOT the app's bin -- so `alr install` never ships it.
--  Built and run by the files post-build actions (see ../../alire.toml).
project Bundle_I18n_Data is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("bundle_i18n_data.adb");

   --  The files project's own warnings and style (config/files_config.gpr
   --  and files.gpr), spelled out because there is no Alire config here.
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatW8", "-gnatwa", "-gnatw.X", "-gnatwe", "-gnatVa", "-gnata",
         "-gnaty3", "-gnatya", "-gnatyA", "-gnatyB", "-gnatyb", "-gnatyc", "-gnatye", "-gnatyf", "-gnatyh",
         "-gnatyi", "-gnatyI", "-gnatyk", "-gnatyl", "-gnatym", "-gnatyn", "-gnatyO", "-gnatyp", "-gnatyr",
         "-gnatyS", "-gnatyt", "-gnatyu", "-gnatyx", "-gnatyM120");
   end Compiler;
end Bundle_I18n_Data;
