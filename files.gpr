with "config/files_config.gpr";
project Files is

   case Files_Config.Alire_Host_OS is
      when "windows" =>
         for Source_Dirs use ("src/", "config/", "src/platform/windows");
      when "macos" =>
         for Source_Dirs use ("src/", "config/", "src/platform/macos");
      when "linux" =>
         for Source_Dirs use ("src/", "config/", "src/platform/linux");
      when others =>
         for Source_Dirs use ("src/", "config/", "src/platform/unsupported");
   end case;
   for Object_Dir use "obj/" & Files_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   --  files-main is the app; bundle_i18n_data is a build helper run as the
   --  post-build action (see alire.toml) to copy the i18n locale data into
   --  share/i18n. It links no GUI libraries -- the Linker switches below are
   --  scoped to files-main so the helper links clean.
   for Main use ("files-main.adb", "bundle_i18n_data.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Files_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnatwU");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      --  Scoped to files-main: the bundle_i18n_data helper main withs no GUI
      --  library and must not pull these in.
      case Files_Config.Alire_Host_OS is
         when "macos" =>
            --  MoltenVK provides Vulkan; gdk-pixbuf for thumbnail decoding;
            --  CoreServices for the native trash API; CoreFoundation/Foundation
            --  for locale.
            for Switches ("files-main.adb") use
              ("-lvulkan", "-lgdk_pixbuf-2.0", "-lgobject-2.0", "-lglib-2.0",
               "-framework", "CoreFoundation", "-framework", "CoreServices",
               "-framework", "Foundation");
         when "windows" =>
            --  shell32 for SHFileOperationW (trash); ole32/kernel32 for shell
            --  and locale APIs; plus Vulkan and gdk-pixbuf. The Vulkan loader
            --  is named vulkan-1 on Windows (vulkan-1.dll), not vulkan.
            for Switches ("files-main.adb") use
              ("-lvulkan-1", "-lgdk_pixbuf-2.0", "-lgobject-2.0", "-lglib-2.0",
               "-lshell32", "-lole32", "-lkernel32");
         when others =>
            for Switches ("files-main.adb") use
              ("-lvulkan", "-lgdk_pixbuf-2.0", "-lgobject-2.0", "-lglib-2.0");
      end case;
   end Linker;

   package Builder is
      for Executable ("files-main.adb") use "files";
      for Executable ("bundle_i18n_data.adb") use "bundle_i18n_data";
   end Builder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Files;
