with "config/files_config.gpr";
project Files is

   Extra_Linker_Switches := External_As_List ("FILES_LDFLAGS", " ");

   --  One source list on every host, and no host-dependent Ada bodies: what
   --  differs by host is Hostkit's, which picks its own bodies.
   for Source_Dirs use ("src/", "config/");
   for Languages use ("Ada");
   for Object_Dir use "obj/" & Files_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("files-main.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Files_Config.Ada_Compiler_Switches &
          ("-gnat2022", "-gnatyM120", "-gnatX", "-gnatwu", "-gnatwC", "-gnatwe");
   end Compiler;

   --  Bytes out as bytes in. Alire's generated switches carry -gnatW8 and the
   --  binder takes its run-time encoding from the same place, which makes
   --  Ada.Text_IO encode every byte above 127 a second time on the way out:
   --  text that was already UTF-8 -- an accented path, an internationalized
   --  domain name, a translated message -- came out doubled. -Wb is the
   --  compiler default and leaves the bytes alone.
   package Binder is
      for Switches ("Ada") use ("-Es", "-Wb"); --  Symbolic traceback
   end Binder;

   --  The native libraries files itself links: Vulkan for rendering and
   --  gdk-pixbuf for thumbnail decoding. The suite links the same code and
   --  reads this list (Files.Native_Libraries) rather than keeping a copy.
   --  The host libraries the platform layer needs -- shell32, ole32 and
   --  advapi32 on Windows, Foundation, CoreFoundation and the Objective-C
   --  runtime on macOS -- are Hostkit's: it declares them in its own
   --  Linker_Options, which every consumer inherits.
   --  MoltenVK provides Vulkan on macOS under the same name.
   Native_Libraries := ("-lvulkan", "-lgdk_pixbuf-2.0", "-lgobject-2.0", "-lglib-2.0");
   case Files_Config.Alire_Host_OS is
      when "windows" =>
         --  The Vulkan loader is named vulkan-1 on Windows (vulkan-1.dll).
         Native_Libraries := ("-lvulkan-1", "-lgdk_pixbuf-2.0", "-lgobject-2.0", "-lglib-2.0");
      when others =>
         null;
   end case;

   package Linker is
      for Default_Switches ("Ada") use Native_Libraries & Extra_Linker_Switches;
   end Linker;

   package Builder is
      for Executable ("files-main.adb") use "files";
   end Builder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Files;
