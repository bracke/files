with "config/files_config.gpr";
project Files is

   --  One source list for every host. There used to be four, each adding a
   --  per-OS body directory; everything in those that was actually per-host --
   --  the trash, the metadata syscalls, the directory watch, the locale -- is
   --  Hostkit's now, and what remained was the same Ada four times over.
   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Files_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("files-main.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Files_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnatwU");
   end Compiler;

   --  Bytes out as bytes in. Alire's generated switches carry -gnatW8 and the
   --  binder takes its run-time encoding from the same place, which makes
   --  Ada.Text_IO encode every byte above 127 a second time on the way out:
   --  text that was already UTF-8 -- an accented path, an internationalized
   --  domain name, a translated message -- came out doubled. -Wb is the
   --  compiler default and leaves the bytes alone.
   package Binder is
      for Switches ("Ada") use ("-Es", "-Wb"); --  Symbolic traceback
   end Binder;

   package Linker is
      case Files_Config.Alire_Host_OS is
         when "macos" =>
            --  MoltenVK provides Vulkan; gdk-pixbuf for thumbnail decoding. The
            --  CoreServices and CoreFoundation frameworks used to be listed here
            --  too, for the native trash and the host locale; both are Hostkit's
            --  now and it declares them in its own Linker_Options, which a
            --  consumer inherits -- the same way shell32 already arrives on
            --  Windows without files naming it.
            for Default_Switches ("Ada") use
              ("-lvulkan", "-lgdk_pixbuf-2.0", "-lgobject-2.0", "-lglib-2.0");
         when "windows" =>
            --  shell32 for SHFileOperationW (trash); ole32/kernel32 for shell
            --  and locale APIs; plus Vulkan and gdk-pixbuf. The Vulkan loader
            --  is named vulkan-1 on Windows (vulkan-1.dll), not vulkan.
            for Default_Switches ("Ada") use
              ("-lvulkan-1", "-lgdk_pixbuf-2.0", "-lgobject-2.0", "-lglib-2.0",
               "-lshell32", "-lole32", "-lkernel32");
         when others =>
            for Default_Switches ("Ada") use
              ("-lvulkan", "-lgdk_pixbuf-2.0", "-lgobject-2.0", "-lglib-2.0");
      end case;
   end Linker;

   package Builder is
      for Executable ("files-main.adb") use "files";
   end Builder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Files;
