with "config/tests_config.gpr";
project Tests is

   Extra_C_Switches := External_As_List ("FILES_CFLAGS", " ");
   Extra_Linker_Switches := External_As_List ("FILES_LDFLAGS", " ");

   for Languages use ("Ada", "C");
   for Source_Dirs use ("tests/src/", "config/");
   for Object_Dir use "obj/" & Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("tests.adb", "noop.adb", "failing.adb", "marker.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Tests_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnatwU");
      for Default_Switches ("C") use
        ("-std=c11", "-Wall", "-Wextra", "-Wpedantic", "-Werror") & Extra_C_Switches;
   end Compiler;

   --  Bytes out as bytes in. Alire's generated switches carry -gnatW8 and the
   --  binder takes its run-time encoding from the same place, which makes
   --  Ada.Text_IO encode every byte above 127 a second time on the way out:
   --  text that was already UTF-8 -- an accented path, an internationalized
   --  domain name, a translated message -- came out doubled. -Wb is the
   --  compiler default and leaves the bytes alone.
   package Binder is
      for Switches ("Ada") use ("-Es", "-Wb"); --  Symbolic traceback
   end Binder;

   --  Mirrors the Linker package in files.gpr: the suite links the application's
   --  own code, so it needs the same native libraries. Keep the two in step.
   package Linker is
      case Tests_Config.Alire_Host_OS is
         when "macos" =>
            for Default_Switches ("Ada") use
              ("-lvulkan", "-lgdk_pixbuf-2.0", "-lgobject-2.0", "-lglib-2.0",
               "-framework", "CoreFoundation", "-framework", "CoreServices",
               "-framework", "Foundation") & Extra_Linker_Switches;
         when "windows" =>
            --  The Vulkan loader is named vulkan-1 on Windows (vulkan-1.dll),
            --  not vulkan.
            for Default_Switches ("Ada") use
              ("-lvulkan-1", "-lgdk_pixbuf-2.0", "-lgobject-2.0", "-lglib-2.0",
               "-lshell32", "-lole32", "-lkernel32", "-ladvapi32") & Extra_Linker_Switches;
         when others =>
            for Default_Switches ("Ada") use
              ("-lvulkan", "-lgdk_pixbuf-2.0", "-lgobject-2.0", "-lglib-2.0") &
              Extra_Linker_Switches;
      end case;
   end Linker;

   package Builder is
      for Executable ("tests.adb") use "tests";
   end Builder;

   package Install is
      for Artifacts (".") use ("tests/share");
   end Install;

end Tests;
