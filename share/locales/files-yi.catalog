yi.error.path.missing = דער וועג עקזיסטירט ניט.
yi.error.path.inaccessible = צום וועג איז ניטאָ קײן צוטריט.
yi.error.startup.too_many_windows = צו פֿיל פֿאָלדערס אויף דער באַפֿעל־שורה; דער דאָזיקער איז ניט געעפֿנט געוואָרן.
yi.error.directory.load = דער פֿאָלדער האָט זיך ניט געלאָזט לאָדן.
yi.error.metadata.read = די מעטאַדאַטן האָבן זיך ניט געלאָזט לײענען.
yi.error.file.create = די טעקע האָט זיך ניט געלאָזט שאַפֿן.
yi.error.file.exists = די טעקע עקזיסטירט שוין.
yi.error.file.parent_missing = דער עלטערן־פֿאָלדער עקזיסטירט ניט.
yi.error.rename.source_missing = דער עלעמענט צום בײַטן דעם נאָמען עקזיסטירט ניט.
yi.error.rename.invalid_destination = דער נײַער נאָמען איז אומגילטיק.
yi.error.rename.failed = דעם עלעמענטס נאָמען האָט זיך ניט געלאָזט בײַטן.
yi.error.rename.stranded = דעם עלעמענטס נאָמען האָט זיך ניט געלאָזט בײַטן, און ער איז געבליבן בײַ {path}.
yi.error.rename.partial = בײַ טײל עלעמענטן האָט זיך דער נאָמען ניט געלאָזט בײַטן.
yi.error.trash.unavailable = דער מיסטקאַסטן איז ניט פֿאַראַן אויף דער פּלאַטפֿאָרמע.
yi.error.trash.failed = דער עלעמענט האָט זיך ניט געלאָזט אַריבערפֿירן אינעם מיסטקאַסטן.
yi.error.trash.volume_unavailable = דער דיסק האָט ניט קײן מיסטקאַסטן; ניט אַריבערגעפֿירט. מעקט אויס אויף שטענדיק.
yi.error.trash.native_unavailable = נאַטיווע מיסטקאַסטן־אינטעגראַציע איז ניט פֿאַראַן אין דער ווערסיע.
yi.error.trash.restore_unavailable = צוריקשטעלן עלעמענטן פֿונעם מיסטקאַסטן איז ניט פֿאַראַן אויף דער פּלאַטפֿאָרמע.
yi.error.trash.restore_failed = דער עלעמענט האָט זיך ניט געלאָזט צוריקשטעלן פֿונעם מיסטקאַסטן.
yi.error.trash.restore_parent_missing = דער אָריגינעלער אָרט עקזיסטירט מער ניט.
yi.error.trash.restore_exists = אויפֿן אָריגינעלן אָרט עקזיסטירט שוין אַן עלעמענט.
yi.error.trash.empty_partial = טײל עלעמענטן האָבן זיך ניט געלאָזט אַוועקנעמען פֿונעם מיסטקאַסטן.
yi.error.trash.empty_failed = דער מיסטקאַסטן האָט זיך ניט געלאָזט אויסלײדיקן.
yi.error.trash.recycle_bin_unusable = דעם דיסקס מיסטקאַסטן קען עס נאָך ניט אָננעמען; ניט אַריבערגעפֿירט.
yi.error.search.failed = דאָס זוכן האָט זיך ניט געלאָזט פֿאַרענדיקן.
yi.error.permanent_delete.refused = אויסמעקן אויף שטענדיק האָט אָפּגעוואָרפֿן אַן אומזיכערן וועג.
yi.error.permanent_delete.failed = דער עלעמענט האָט זיך ניט געלאָזט אויסמעקן אויף שטענדיק.
yi.error.permissions.failed = די רעכטן האָבן זיך ניט געלאָזט בײַטן.
yi.error.permissions.unsupported = בײַטן רעכטן ווערט ניט געשטיצט אויף דער פּלאַטפֿאָרמע.
yi.error.ownership.denied = קען ניט בײַטן דעם באַזיץ. באַזיצער אָדער גרופּע בײַטן פֿאָדערט געווײנטלעך root.
yi.error.ownership.unsupported = בײַטן באַזיץ ווערט ניט געשטיצט אויף דער פּלאַטפֿאָרמע.
yi.error.ownership.invalid_name = קײן אַזאַ באַניצער־ אָדער גרופּע־נאָמען ניטאָ.
yi.error.drop.invalid_destination = דער אַראָפּלאָז־ציל איז ניט קײן פֿאָלדער.
yi.error.drop.invalid_source = דער אַראָפּגעלאָזטער עלעמענט עקזיסטירט ניט.
yi.error.drop.into_self = אַ פֿאָלדער קען מען ניט אַריבערפֿירן אָדער קאָפּירן אין זיך אַלײן.
yi.error.copy.failed = קען ניט קאָפּירן דעם עלעמענט.
yi.error.io.no_space = ניט גענוג פֿרײַער אָרט.
yi.error.io.denied = צוטריט אָפּגעזאָגט.
yi.error.io.read_only = דער אָרט איז נאָר צום לײענען.
yi.error.io.busy = דער עלעמענט ווערט באַניצט.
yi.error.move.source_changed = דער עלעמענט האָט זיך געביטן בעת דעם אַריבערפֿירן, איז ער געבליבן וווּ ער איז געווען.
yi.error.move.source_set_aside = געביטן בעתן אַריבערפֿירן: קאָפּיע געהאַלטן, אָריגינאַל אָפּגעלײגט צום צוריקשטעלן.
yi.error.paste.undo_unavailable = קען ניט אָפּטאָן: די קאָפּיע האָט זיך געביטן. דער פֿאַרביטענער איז אינעם מיסטקאַסטן.
yi.error.operation.undo_unavailable = אָפּטאָן ניט צוטריטלעך: די געשיכטע איז ניט לייענבאַר.
yi.error.io.name_too_long = דער נאָמען איז צו לאַנג.
yi.error.duplicate.failed = קען ניט דופּלירן די אויסגעקליבענע עלעמענטן.
yi.error.link.failed = קען ניט שאַפֿן דעם לינק.
yi.error.terminal.unavailable = קײן טערמינאַל־עמולאַטאָר ניטאָ.
yi.error.compress.failed = קען ניט שאַפֿן דעם אַרכיוו.
yi.error.compress.unportable_name = אַרכיוו ניט געשאַפֿן: אַ נאָמען אַנטהאַלט אַ צווײ־פּינטל אָדער אַ צוריקשטריך.
yi.error.compress.links_skipped = סימבאָלישע לינקען זענען אויסגעלאָזט געוואָרן פֿונעם אַרכיוו.
yi.error.compress.special_skipped = לינקען, מכשירים, רערן און סאָקעטן זענען אויסגעלאָזט געוואָרן פֿונעם אַרכיוו.
yi.error.extract.failed = קען ניט אויספּאַקן דעם אַרכיוו.
yi.error.extract.entry_refused = ניט אויסגעפּאַקט: דער פֿאָלדער קען ניט האַלטן דעם אַרכיוו־אַרײַנטראָג {path}.
yi.error.extract.not_archive = דער אויסקלײַב אַנטהאַלט ניט קײן אַרכיוו.
yi.error.extract.encrypted = דער אַרכיוו איז ניט אויסגעפּאַקט: ער איז געשיצט מיט אַ פּאַראָל.
yi.error.extract.damaged = דער אַרכיוו איז ניט אויסגעפּאַקט: ער איז פֿאַרדאָרבן.
yi.error.extract.unsupported = דער אַרכיוו איז ניט אויסגעפּאַקט: ער ניצט אַ קאָמפּרעסיע־מעטאָד וואָס ווערט ניט געשטיצט.
yi.error.undo.failed = קען ניט אָפּטאָן די לעצטע אַקציע.
yi.error.redo.failed = קען ניט איבערטאָן די לעצטע אַקציע.
yi.error.operation.failed = די אָפּעראַציע האָט זיך ניט געלאָזט פֿאַרענדיקן.
yi.error.drop.failed = דער אַראָפּגעלאָזטער עלעמענט האָט זיך ניט געלאָזט אַרײַנפֿירן.
yi.error.drop.cancelled = אָפּגעשטעלט.
yi.error.drop.interrupted = די אָפּעראַציע איז איבערגעריסן געוואָרן פֿאַר זי האָט זיך געענדיקט.
yi.error.thumbnail.source_missing = דער מקור פֿאַר דער מיניאַטור עקזיסטירט ניט.
yi.error.thumbnail.unsupported = דער מקור פֿאַר דער מיניאַטור איז ניט קײן געווײנטלעכע טעקע.
yi.error.thumbnail.failed = די מיניאַטור האָט זיך ניט געלאָזט שאַפֿן.
yi.error.history.back_unavailable = די צוריק־היסטאָריע איז לײדיק.
yi.error.history.forward_unavailable = די פֿאָרויס־היסטאָריע איז לײדיק.
yi.error.navigate.no_parent = דער איצטיקער פֿאָלדער האָט ניט קײן עלטערן־פֿאָלדער.
yi.error.selection.empty = קײן עלעמענט איז ניט אויסגעקליבן.
yi.error.create.pending = אַ טעקע־שאַפֿונג וואַרט שוין.
yi.error.command.trash_view = דאָס קען מען ניט טאָן אינעם מיסטקאַסטן.
yi.error.command.recent_view = דאָס קען מען ניט טאָן אין דער רשימה פֿון לעצטע עלעמענטן.
yi.error.clipboard.empty = דער קלעמברעט איז לײדיק.
yi.error.create.no_temporary_item = קײן וואַרטנדיקע טעקע־שאַפֿונג ניטאָ.
yi.error.filter.empty = קײן פֿילטער איז ניט אַקטיוו.
yi.error.root.selection.empty = קײן טעקע־סיסטעם־וואָרצל איז ניט אויסגעקליבן.
yi.error.root.eject_unavailable = דער אויסגעקליבענער וואָרצל קען ניט אַרויסגעוואָרפֿן ווערן אין דער ווערסיע.
yi.error.name.invalid = דער נאָמען איז אומגילטיק.
yi.error.rename.disabled = נאָמען־בײַטן איז ניט פֿאַראַן פֿאַרן איצטיקן אויסקלײַב.
yi.error.open_action.missing = קײן עפֿן־אַקציע איז ניט קאָנפֿיגורירט פֿאַר דעם טעקע־טיפּ.
yi.error.open_action.multi_directory = עטלעכע אויסגעקליבענע פֿאָלדערס קען מען ניט עפֿענען אין אײן פֿענצטער.
yi.error.open_action.execution = די קאָנפֿיגורירטע עפֿן־אַקציע האָט זיך ניט געלאָזט אויספֿירן.
yi.error.open_action.executable_missing = דער פּראָגראַם פֿון דער קאָנפֿיגורירטער עפֿן־אַקציע איז ניט געפֿונען געוואָרן.
yi.error.open_action.unsafe_placeholder = די עפֿן־אַקציע אַנטהאַלט אַן אײַנגעבעטן פּלאַצהאַלטער.
yi.error.open.path_too_long = דער וועג איז צו לאַנג פֿאַר Windows צו עפֿענען; גאָרנישט איז ניט געשטאַרט געוואָרן.
yi.error.settings.unknown_section = די באַשטימונגען־טעקע אַנטהאַלט אַן אומבאַקאַנטן אָפּטײל.
yi.error.settings.expected_equals = אַ באַשטימונגען־אַרײַנטראָג מוז אַנטהאַלטן אַ גלײַכצײכן.
yi.error.settings.invalid_open_action = די באַשטימונגען־טעקע אַנטהאַלט אַן אומגילטיקע עפֿן־אַקציע.
yi.error.settings.invalid_mapping = די באַשטימונגען־טעקע אַנטהאַלט אַן אומגילטיקע צוטײלונג.
yi.error.settings.invalid_view_mode = די באַשטימונגען־טעקע אַנטהאַלט אַן אומגילטיקע אָנזיכט.
yi.error.settings.invalid_boolean = די באַשטימונגען־טעקע אַנטהאַלט אַן אומגילטיקן בולישן ווערט.
yi.error.settings.invalid_theme = די באַשטימונגען־טעקע אַנטהאַלט אַן אומגילטיקע טעמע.
yi.error.settings.invalid_icon_theme = די באַשטימונגען־טעקע אַנטהאַלט אַן אומגילטיקע איקאָן־טעמע.
yi.error.settings.invalid_font_pixel_size = די שריפֿט־גרײס אין פּיקסלען מוז זײַן אַ גאַנצע צאָל צווישן 10 און 32.
yi.error.settings.invalid_sort_field = די באַשטימונגען־טעקע אַנטהאַלט אַן אומגילטיק סאָרטיר־פֿעלד.
yi.error.settings.invalid_group = די באַשטימונגען־טעקע אַנטהאַלט אַן אומגילטיקע גרופּירונג.
yi.error.settings.invalid_label = די באַשטימונגען־טעקע אַנטהאַלט אַן אומגילטיקן קאָליר־עטיקעט.
yi.error.settings.invalid_column_order = די באַשטימונגען־טעקע אַנטהאַלט אַן אומגילטיקן סדר פֿון פּרטים־שפּאַלטן.
yi.error.settings.unknown_key = די באַשטימונגען־טעקע אַנטהאַלט אַן אומבאַקאַנטן שליסל.
yi.error.settings.missing_section = אַ באַשטימונגען־אַרײַנטראָג קומט פֿאַר יעדן אָפּטײל.
yi.error.settings.invalid = די באַשטימונגען־טעקע איז אומגילטיק.
yi.error.settings.full = צו פֿיל קאָליר־עטיקעטן און באַליבטע צום אָפּהיטן. נעמט קודם אַוועק עטלעכע.
yi.error.settings.not_file = דער באַשטימונגען־וועג איז ניט קײן געווײנטלעכע טעקע.
yi.error.settings.load = די באַשטימונגען־טעקע האָט זיך ניט געלאָזט לאָדן.
yi.error.settings.save = די באַשטימונגען־טעקע האָט זיך ניט געלאָזט אָפּהיטן.
yi.warning.settings.not_durable = באַשטימונגען אָפּגעהיט, נאָר די דאַוערהאַפֿטיקײט איז ניט באַשטעטיקט.
yi.error.settings.closed = דער באַשטימונגען־פּאַנעל איז ניט אָפֿן.
yi.error.settings.not_persisted = די באַשטימונגען ווערן ניט אָפּגעהיט: די באַשטימונגען־טעקע האָט זיך ניט געלאָזט לאָדן.
yi.error.settings.changed_elsewhere = ניט געראַטעוועט: די טעקע איז אַנדערש וווּ געענדערט און לאָדט זיך ניט.
